---
import type { Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
  t: {
    kicker: string;
    role: string;
    bio: string;
    github: string;
    linkedin: string;
    contactCta: string;
  };
}

const { lang, t } = Astro.props;
const basePath = lang === "en" ? "/en" : "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const contactHref = `${base}${basePath}/#contact`;
---

<section
  id="top"
  class="scroll-mt-28 grid min-h-[85svh] grid-cols-1 items-center gap-12 py-16 md:grid-cols-2 md:gap-16 md:py-20"
>
  <div class="flex flex-col justify-center">
    <p
      class="mb-3 text-xs font-medium uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500"
    >
      {t.kicker}
    </p>
    <h1
      class="text-balance text-4xl font-semibold tracking-tight text-zinc-900 dark:text-white sm:text-5xl"
    >
      Osmar Barrientos
    </h1>
    <p class="mt-2 text-lg font-medium text-emerald-700 dark:text-emerald-400/95 sm:text-xl">
      {t.role}
    </p>
    <p
      class="mt-6 max-w-lg text-pretty text-[17px] leading-relaxed text-zinc-600 dark:text-zinc-400"
    >
      {t.bio}
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-300/90 bg-white px-5 py-2.5 text-sm font-medium text-zinc-800 shadow-sm transition-colors hover:border-zinc-400 hover:bg-zinc-50 dark:border-white/12 dark:bg-white/[0.04] dark:text-zinc-100 dark:shadow-none dark:hover:border-white/20 dark:hover:bg-white/[0.08]"
        href="https://github.com/x-osmar-x"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          class="opacity-90"
          aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
          ></path></svg
        >
        {t.github}
      </a>
      <a
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-transparent bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-emerald-500 dark:bg-emerald-500/90 dark:text-zinc-950 dark:hover:bg-emerald-400"
        href="https://www.linkedin.com/in/osmar-barrientos-chuveyzer-51934715a"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          class="opacity-90"
          aria-hidden="true"
          ><path
            fill="currentColor"
            d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"
          ></path></svg
        >
        {t.linkedin}
      </a>
      <a
        class="inline-flex items-center justify-center rounded-lg px-5 py-2.5 text-sm font-medium text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-300"
        href={contactHref}
      >
        {t.contactCta}
      </a>
    </div>
  </div>

  <div class="flex justify-center md:justify-end">
    <div
      class="claw-img-container group relative flex h-[280px] w-[280px] cursor-default items-center justify-center sm:h-[320px] sm:w-[320px]"
    >
      <div
        class="pointer-events-none absolute inset-4 rounded-2xl border border-zinc-200/80 bg-gradient-to-b from-zinc-100/80 to-transparent dark:border-white/[0.06] dark:from-white/[0.03]"
        aria-hidden="true"
      ></div>
      <svg
        class="absolute inset-0 z-20 h-full w-full"
        width="320"
        height="320"
        viewBox="0 0 320 320"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <clipPath id="clawClip">
            <rect x="100" y="120" width="30" height="120" rx="14"></rect>
            <rect x="160" y="140" width="30" height="120" rx="14"></rect>
            <rect x="80" y="200" width="40" height="60" rx="20"></rect>
          </clipPath>
        </defs>
        <image
          href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/foto.jpg`}
          width="320"
          height="320"
          clip-path="url(#clawClip)"
          preserveAspectRatio="xMidYMid slice"
        />
        <g>
          <path
            d="M113 151.5V145.5L122 139L128.5 128.5V117L135 109.5L139.5 95.5L149 81.5L160.5 76V70L174.5 56L167.5 76L160.5 90L149 109.5V117L139.5 122.5L142.5 131.5L135 139L128.5 151.5L122 160.5L113 171L105 186L89 206.5L96 179.5V171L105 165.5V160.5L109 149.5L113 151.5Z"
            fill="#E62C2C"
            stroke="black"></path>
          <path
            d="M172 190.5V184.5L181 178L187.5 167.5V156L194 148.5L198.5 134.5L208 120.5L219.5 115V109L233.5 95L226.5 115L219.5 129L208 148.5V156L198.5 161.5L201.5 170.5L194 178L187.5 190.5L181 199.5L172 210L164 225L148 245.5L155 218.5V210L164 204.5V199.5L168 188.5L172 190.5Z"
            fill="#E62C2C"
            stroke="black"></path>
          <path
            d="M103 250.5L116.5 215H118.5L120 208.5L123 204.5V198.5L130.5 189.5V184.5L133.5 182.5V176L142 169.5L140.5 163.5L146 159V155L154 143.5L159 138.5L162 132.5V126V124H167V115.5L178.5 103.5L181.5 98.5V92H186L188.5 84L198 72H200V68.5L219.5 44L200 81.5L196.5 87L192 98.5L186 110L184.5 115.5V124L180 126C178 129.167 173.9 135.8 173.5 137C173.1 138.2 169 145.833 167 149.5L165 153.5V159L159 166.5L156 176L146 184.5L142 191.5L137 194V204.5L133.5 208.5L125 217.5L123 225H118.5V230.5L113.5 240.5L103 250.5Z"
            fill="#DC2D2D"
            stroke="black"></path>
        </g>
      </svg>
    </div>
  </div>
</section>

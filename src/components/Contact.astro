---
import ContactForm from "./ContactForm.astro";

interface Props {
  t: {
    kicker: string;
    title: string;
    body: string;
    linkedinBtn: string;
    github: string;
    email: string;
  };
}

const { t } = Astro.props;
---

<section
  id="contact"
  class="scroll-mt-28 relative mt-16 border border-zinc-200/90 bg-white/60 py-16 text-zinc-900 dark:border-white/[0.06] dark:bg-zinc-900/35 dark:text-zinc-100 md:mb-12 md:rounded-2xl md:py-20"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_80%_20%,rgba(16,185,129,0.07),transparent_50%)] dark:bg-[radial-gradient(ellipse_60%_40%_at_80%_20%,rgba(16,185,129,0.05),transparent_50%)] md:rounded-2xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-xl px-1 text-center sm:px-0">
    <p
      class="text-xs font-medium uppercase tracking-[0.16em] text-zinc-500 dark:text-zinc-500"
    >
      {t.kicker}
    </p>
    <h2
      class="mt-2 text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white md:text-3xl"
    >
      {t.title}
    </h2>
    <p
      class="mx-auto mt-4 max-w-md text-pretty text-[15px] leading-relaxed text-zinc-600 dark:text-zinc-400"
    >
      {t.body}
    </p>

    <div
      class="mt-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:justify-center"
    >
      <a
        href="mailto:o1993bch@gmail.com"
        onclick="window.location.href = `mailto:o1993bch@gmail.com?subject=${subject}&body=${body}`;"
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-transparent bg-emerald-600 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-emerald-500 dark:bg-emerald-500/90 dark:text-zinc-950 dark:hover:bg-emerald-400"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          class="shrink-0 opacity-90"
          aria-hidden="true"
          ><path
            fill="currentColor"
            d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4l-8 5-8-5V6l8 5 8-5z"
          ></path></svg
        >
        {t.email}
      </a>
      <a
        href="https://www.linkedin.com/in/osmar-barrientos-chuveyzer-51934715a"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-300/90 bg-white px-6 py-3 text-sm font-medium text-zinc-800 shadow-sm transition-colors hover:border-zinc-400 hover:bg-zinc-50 dark:border-white/[0.1] dark:bg-zinc-950/50 dark:text-zinc-100 dark:shadow-none dark:hover:border-white/[0.18] dark:hover:bg-zinc-900/80"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          class="shrink-0 opacity-90"
          aria-hidden="true"
          ><path
            fill="currentColor"
            d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"
          ></path></svg
        >
        {t.linkedinBtn}
      </a>
      <a
        href="https://github.com/x-osmar-x"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-transparent bg-zinc-900 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:border-white/[0.1] dark:bg-zinc-950/50 dark:text-zinc-100 dark:hover:bg-zinc-900/80"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          class="shrink-0 opacity-90"
          aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
          ></path></svg
        >
        {t.github}
      </a>
    </div>

    <div class="mt-16">
      <ContactForm />
    </div>
  </div>
</section>
